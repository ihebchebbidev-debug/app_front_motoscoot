# Server
PORT=4000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DB_SSL=true

# Auth
JWT_SECRET=your-super-secret-key-change-me
JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://moto-scoot.tn,https://www.moto-scoot.tn

# Uploads
UPLOAD_MAX_SIZE=10485760

# ----- Clerk (Google + Apple sign-in) -----
# Pin the issuer to your Clerk Frontend API host so tokens from another tenant
# can't be accepted. For moto-scoot.tn the issuer is:
CLERK_ISSUER=https://clerk.moto-scoot.tn
# Optional: pin the audience claim if you configure one in Clerk.
# CLERK_AUDIENCE=
#
# Verification mode A (recommended): static PEM public key.
# Newlines may be written as literal \n on a single line — they will be
# normalized at runtime. Example (the value below is the project's live key):
CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAwXKmFGn7mqGJSJCmoVfM\nQSwbsCYVnBP7rfxWt9tQjM2ZxZL+nXNv/6kixf2pKYPWXJTVDtT4BkCCRPL/WCqV\n/bdSnDQQq3fDyT5LnHiSxb0nan5AOqoK0j4vtWSmVBIaq6GsBx3q+ayHikCQthh0\nKmUPL+2l7SBAKsUA3/BZKw2kx+Ist45kni//os15dnHd6l1jczwS06ClXOMEDA+c\nQud/oUuPHwXk/YPv5WuizMEZmjnDrZ6/SZktAiuZh4TxPCI1a1gKbhJgJdnIaZo3\nwNZ31YU/Y4H/HY7djI/MhMMCMZzCkpl5H6fRci4P3qzCG2Y+V4tDvsVWaDNqxm9Q\nlwIDAQAB\n-----END PUBLIC KEY-----"
#
# Verification mode B (alternative): fetch keys from Clerk JWKS endpoint.
# CLERK_JWKS_URL=https://clerk.moto-scoot.tn/.well-known/jwks.json
